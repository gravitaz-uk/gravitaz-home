---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const engagements = (await getCollection('engagements')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Engagements | ${SITE_TITLE}`}
			description="Selected enterprise architecture engagements — the challenge, the approach and the outcome in each case."
		/>
		<style>
			.lede {
				color: rgb(var(--gray-dark));
				font-size: 1.1em;
				margin-bottom: 2.5em;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				padding: 1.25em 0;
				border-top: 1px solid rgb(var(--gray-light));
			}
			li:last-child {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.period {
				margin: 0 0 0.2em 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.title {
				margin: 0 0 0.3em 0;
				line-height: 1.25;
			}
			.title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.title a:hover {
				color: rgb(var(--accent));
			}
			.summary {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.sector {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Engagements</h1>
			<p class="lede">
				Gravitaz is normally engaged for three to twelve months to assess, define and de-risk a
				transformation, then hand over a working practice. Each engagement below is written up as
				the challenge, the approach taken and what came of it.
			</p>
			<section>
				<ul>
					{
						engagements.map((engagement) => (
							<li>
								<p class="period">{engagement.data.period}</p>
								<h2 class="title">
									<a href={`/engagements/${engagement.id}/`}>{engagement.data.title}</a>
								</h2>
								<p class="summary">{engagement.data.description}</p>
								{engagement.data.sector && <p class="sector">{engagement.data.sector}</p>}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
